{
  "name": "SaaS Modern Dark (Stripe/Datadog Style)",
  "dataColors": [
    "#38BDF8",
    "#34D399",
    "#F43F5E",
    "#FBBF24",
    "#A78BFA",
    "#FB7185",
    "#818CF8",
    "#2DD4BF"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#1E293B",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1E293B" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#334155" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#94A3B8" } },
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#94A3B8" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
